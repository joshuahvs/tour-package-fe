# API Base URL for Backend
VITE_API_BASE_URL=http://localhost:8080/api

# Top-Up API endpoint (used to fetch transaction history).
# You may set either variable below; VITE_TOPUP_API_BASE_URL takes precedence.
VITE_TOPUP_API_BASE_URL=http://localhost:8081/api/topup
VITE_TOPUP_SERVICE_URL=http://localhost:8081/api/topup
